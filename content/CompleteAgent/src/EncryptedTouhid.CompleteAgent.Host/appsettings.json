{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*",
  "Agent": {
    "Provider": "AzureOpenAI",
    "Model": "gpt-4o-mini",
    "AzureOpenAI": {
      "Endpoint": ""
    },
    "OpenAI": {
      "ApiKey": ""
    }
  },
  "Authentication": {
    "ApiKeys": []
  },
  "Jwt": {
    "Enabled": false,
    "Authority": "",
    "Audience": "",
    "ValidIssuers": [],
    "ClockSkewSeconds": 30
  },
  "RateLimit": {
    "Store": "InMemory",
    "PermitLimit": 60,
    "WindowSeconds": 60,
    "RedisConnectionString": "localhost:6379"
  },
  "Resilience": {
    "MaxRetryAttempts": 3,
    "BackoffSeconds": 2
  },
  "CostBudget": {
    "Enabled": false,
    "DailyTokenLimitPerKey": 1000000
  },
  "SecurityHeaders": {
    "Enabled": true,
    "HstsMaxAgeSeconds": 31536000,
    "HstsIncludeSubdomains": true,
    "ContentSecurityPolicy": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'",
    "ReferrerPolicy": "strict-origin-when-cross-origin",
    "PermissionsPolicy": "camera=(), microphone=(), geolocation=()"
  },
  "Cors": {
    "Enabled": false,
    "AllowedOrigins": []
  },
  "Idempotency": {
    "Enabled": true,
    "TtlMinutes": 10,
    "MaxKeyLength": 128
  },
  "Telemetry": {
    "ServiceName": "complete-agent",
    "OtlpEndpoint": null,
    "EnableConsoleExporter": true
  },
  "Conversation": {
    "TtlMinutes": 60,
    "MaxMessagesPerConversation": 50
  },
  "Persistence": {
    "ConversationStore": "InMemory",
    "ConnectionString": "Data Source=completeagent.db"
  },
  "Retrieval": {
    "EmbeddingModel": "text-embedding-3-small",
    "VectorStore": "InMemory",
    "Qdrant": {
      "Host": "localhost",
      "Port": 6334,
      "UseTls": false,
      "Collection": "agent-docs",
      "VectorSize": 1536
    }
  },
  "Moderation": {
    "Provider": "None",
    "AzureEndpoint": "",
    "MaxAllowedSeverity": 2
  }
}
