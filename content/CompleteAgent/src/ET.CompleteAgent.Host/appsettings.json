{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*",
  "Agent": {
    "Provider": "AzureOpenAI",
    "Model": "gpt-4o-mini",
    "AzureOpenAI": {
      "Endpoint": ""
    },
    "OpenAI": {
      "ApiKey": ""
    }
  },
  "Authentication": {
    "ApiKeys": []
  },
  "RateLimit": {
    "Store": "InMemory",
    "PermitLimit": 60,
    "WindowSeconds": 60,
    "RedisConnectionString": "localhost:6379"
  },
  "Resilience": {
    "MaxRetryAttempts": 3,
    "BackoffSeconds": 2
  },
  "Telemetry": {
    "ServiceName": "complete-agent",
    "OtlpEndpoint": null,
    "EnableConsoleExporter": true
  },
  "Conversation": {
    "TtlMinutes": 60,
    "MaxMessagesPerConversation": 50
  },
  "Retrieval": {
    "EmbeddingModel": "text-embedding-3-small",
    "VectorStore": "InMemory",
    "Qdrant": {
      "Host": "localhost",
      "Port": 6334,
      "UseTls": false,
      "Collection": "agent-docs",
      "VectorSize": 1536
    }
  },
  "Persistence": {
    "ConversationStore": "InMemory",
    "ConnectionString": "Data Source=completeagent.db"
  },
  "Jwt": {
    "Enabled": false,
    "Authority": "",
    "Audience": "",
    "ValidIssuers": [],
    "ClockSkewSeconds": 30
  },
  "Moderation": {
    "Provider": "None",
    "AzureEndpoint": "",
    "MaxAllowedSeverity": 2
  },
  "CostBudget": {
    "Enabled": false,
    "DailyTokenLimitPerKey": 1000000
  }
}
